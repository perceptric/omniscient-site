# Hostinger (LiteSpeed/Apache) settings for the static Omniscient site
ErrorDocument 404 /404.html
DirectoryIndex index.html
Options -Indexes

RewriteEngine On

# Hostinger deploys the whole repo here, so hide the git folder, dot files, the README and docs
RewriteRule (^|/)\.(?!well-known/) - [F]
RewriteRule ^(README\.md|docs/) - [F]
# Blog sources and drafts (blog/_src/, anything whose name starts with "_") and shot snippets are built into pages, never served
RewriteRule (^|/)_ - [F]
RewriteRule \.shot\.html$ - [F]
# One host: www -> apex, http -> https
RewriteCond %{HTTP_HOST} ^www\.tryomniscient\.com$ [NC]
RewriteRule ^(.*)$ https://tryomniscient.com/$1 [R=301,L]
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# Icon names that browsers and phones ask for on their own
RewriteRule ^favicon\.ico$ /assets/brand/favicon.ico [R=301,L]
RewriteRule ^icon\.svg$ /assets/brand/icon.svg [R=301,L]
RewriteRule ^apple-(touch-)?icon(-precomposed)?\.png$ /assets/brand/apple-icon.png [R=301,L]

# Removed pages: Outbound LinkedIn became Contract Management, and the LinkedIn posts went back to the blog index
RewriteRule ^product/linkedin-outbound/?$ /product/contract-management/ [R=301,L]
RewriteRule ^blog/(automate-linkedin-outreach-without-getting-restricted|best-linkedin-automation-tools|dripify-alternatives|expandi-alternatives|heyreach-alternatives|heyreach-vs-expandi|lemlist-alternatives|linked-helper-alternatives|linkedin-automation-pricing|linkedin-automation-tools-for-agencies|linkedin-connection-request-limit|linkedin-outreach-tools-with-crm|safest-linkedin-automation-tools|waalaxy-alternatives|waalaxy-vs-lemlist|best-crm-for-linkedin|crm-with-linkedin-integration)/?$ /blog/ [R=301,L]

# Like the app's src/proxy.ts: any other page path goes to the same path on the app
# (/today -> https://app.tryomniscient.com/today). Real files and folders are served here,
# so /privacy still gets its trailing slash. A missing file (a path ending in .png, .js and so on) gets 404.html.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !\.[a-zA-Z0-9]+$
RewriteRule ^(.+)$ https://app.tryomniscient.com/$1 [R=301,L]

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType image/vnd.microsoft.icon "access plus 1 year"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType text/html "access plus 10 minutes"
</IfModule>
